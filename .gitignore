# ---- DAIC ARCHIVE: added for Round 2 backend ----

# Heritage corpus (1.3 GB of PDFs, JP2 scans, audio, video).
# Source material is NOT version-controlled; it is referenced by
# checksum in the ingestion manifest instead.
Data/

# Python
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Generated archive artifacts — rebuildable from Data/ via the ingest
# pipeline, so they stay out of git.
backend/archive/*.db
backend/archive/*.db-journal
backend/archive/*.db-wal
backend/archive/*.db-shm
backend/archive/*.faiss
backend/archive/manifest.json
backend/archive/derived/

